# Koneksi database Neon (pooled, untuk runtime serverless)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Koneksi database Neon (direct, untuk migrasi & seed)
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Secret untuk menandatangani cookie sesi. Buat dengan: openssl rand -base64 32
AUTH_SECRET=""

# Hash bcrypt dari password login. Buat dengan: npm run hash-password
APP_PASSWORD_HASH=""

# URL publik situs (localhost saat dev, domain Netlify saat produksi)
AUTH_URL="http://localhost:3000"
